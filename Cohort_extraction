#30. Now we look at when was the first ASD diagnosis, then follow a year after that, and stop at july 2024 in order to be able to follow the visits until end of the data.

Identifies ASD patients
Finds their first diagnosis date (index)
Keeps only those with 1-year follow-up
Defines a 12-month window
Counts ABA utilization within that window
```{r}

#1. Index the ASD diagnosis to be before July 2024, because the data ends at June 2025, we need to be able to follow up for the next 365 days on how many visits we got

diag_cols <- paste0("diag", 1:12)

Aba_claims_all_years <- Aba_claims_all_years %>%
  mutate(
    across(all_of(diag_cols), ~ gsub("\\.", "", .x))  # remove dots
  )

#2. Identify ASD index date

asd_first_date <- Aba_claims_all_years %>%
  filter(
    if_any(all_of(diag_cols), ~ .x %in% ASD_diagnoses_code)
  ) %>%
  group_by(pat_id) %>%
  summarise(
    asd_index_date = min(from_dt),
    .groups = "drop"
  )

#3. Follow up for one year
max_date <- max(Aba_claims_all_years$from_dt, na.rm = TRUE)

asd_first_date <- asd_first_date %>%
  filter(asd_index_date <= max_date - days(365))


#4. Define one year follow up window

asd_window <- asd_first_date %>%
  mutate(
    end_date = asd_index_date + days(365)
  )

#5. Count the ABA claims within one year
aba_visits_1yr <- Aba_claims_all_years %>%
  inner_join(asd_window, by = "pat_id") %>%
  filter(
    from_dt >= asd_index_date &
    from_dt <= end_date
  ) %>%
  group_by(pat_id) %>%
  summarise(
    visits_1yr = n_distinct(from_dt),
    .groups = "drop"
  )

```



