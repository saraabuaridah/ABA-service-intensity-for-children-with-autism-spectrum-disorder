
library(arrow)
library(dplyr)
library(data.table)

aba_proc_codes <- c(
  "97151", "97152", "97153", "97154", "97155",
  "97156", "97157", "97158", "0362T", "0373T"
)

# Configure input and output directories.
base_path <- Sys.getenv("CLAIMS_DATA_DIR")
output_path <- Sys.getenv("CLAIMS_OUTPUT_DIR")

if (!dir.exists(base_path) || !dir.exists(output_path)) {
  stop("Set CLAIMS_DATA_DIR and CLAIMS_OUTPUT_DIR to existing directories.")
}

# Identify ABA recipients and retain their associated claims.
patient_ids <- character()
annual_files <- character()

for (year in 2020:2025) {
  year_path <- file.path(base_path, paste0("year=", year))
  files <- list.files(
    year_path,
    pattern = "\\.parquet$",
    full.names = TRUE
  )

  year_claims <- list()

  for (file in files) {
    claims <- arrow::read_parquet(file) %>%
      as.data.frame() %>%
      mutate(across(everything(), as.character))

    current_aba_ids <- claims %>%
      filter(proc_cde %in% aba_proc_codes) %>%
      distinct(pat_id) %>%
      pull(pat_id)

    patient_ids <- union(patient_ids, current_aba_ids)

    year_claims[[length(year_claims) + 1L]] <- claims %>%
      filter(pat_id %in% patient_ids)
  }

  annual <- dplyr::bind_rows(year_claims)

  annual_file <- file.path(
    output_path,
    paste0("ABA_claims_", year, ".csv")
  )

  data.table::fwrite(annual, annual_file)
  annual_files <- c(annual_files, annual_file)
}

# Combine annual claims and identify unique patients.
Aba_claims_all_years <- dplyr::bind_rows(
  lapply(annual_files, function(path) {
    data.table::fread(path, colClasses = "character") %>%
      as.data.frame()
  })
)

Aba_patients_ids <- Aba_claims_all_years %>%
  distinct(pat_id)


